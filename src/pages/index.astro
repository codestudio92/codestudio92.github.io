---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingFeature from '../components/landing/LandingFeature.astro';
import LandingQuote from '../components/landing/LandingQuote.astro';
import LandingPricing from '../components/landing/LandingPricing.astro';
import LandingCta from '../components/landing/LandingCta.astro';
---

<Layout title="Code Studio 92">
  <SiteHeader />
  <main>
    <LandingHero />

    <LandingFeature
      id="servicos"
      index="01"
      label="Engenharia"
      title="Arquitetura antes da interface."
      body="Não fabricamos software. Construímos produtos digitais. Cada decisão de stack, domínio e fluxo nasce de um problema real, não de moda."
      points={[
        {
          icon: 'ph-thin ph-brackets-curly',
          text: 'Web, mobile e AI com a mesma disciplina de entrega',
        },
        {
          icon: 'ph-thin ph-crosshair',
          text: 'Escopo preciso: o que entra, o que fica fora',
        },
        {
          icon: 'ph-thin ph-shield-check',
          text: 'Qualidade verificável em cada marco',
        },
      ]}
      linkLabel="Como trabalhamos"
      linkHref="#metodo"
    >
      <div class="vis-panel featured" aria-hidden="true">
        <div class="vis-head">
          <span class="label">Stack ativa</span>
          <span class="meta">3 frentes</span>
        </div>
        <div class="stack-row">
          <div class="stack-item">
            <i class="ph-thin ph-browser"></i>
            <span class="name">Produto web</span>
            <span class="tag">Astro · React</span>
          </div>
          <div class="stack-item">
            <i class="ph-thin ph-device-mobile"></i>
            <span class="name">App mobile</span>
            <span class="tag">React Native</span>
          </div>
          <div class="stack-item">
            <i class="ph-thin ph-brain"></i>
            <span class="name">Camada AI</span>
            <span class="tag">Agents · RAG</span>
          </div>
        </div>
      </div>
    </LandingFeature>

    <LandingFeature
      id="metodo"
      index="02"
      label="Método"
      title="Do brief ao forjamento."
      body="Cada ideia é moldada até se tornar um produto sólido. Discovery curto, design com restrições, implementação com ritmo mecânico."
      points={[
        {
          icon: 'ph-thin ph-lightbulb',
          text: 'Discovery: problema, restrições, critérios de sucesso',
        },
        {
          icon: 'ph-thin ph-blueprint',
          text: 'Design: contratos, fluxos, linguagem visual',
        },
        {
          icon: 'ph-thin ph-hammer',
          text: 'Build: entregas atômicas, revisão contínua',
        },
      ]}
      reverse
      linkLabel="Ver pipeline"
      linkHref="#engajamentos"
    >
      <div class="vis-panel" aria-hidden="true">
        <div class="vis-head">
          <span class="label">Pipeline do studio</span>
          <span class="meta">4 etapas</span>
        </div>
        <div class="pipeline">
          <div class="pipeline-step">
            <span class="idx">01</span>
            <div>
              <div class="title">Brief</div>
              <p class="desc">Contexto, stakeholders e resultado esperado.</p>
            </div>
          </div>
          <div class="pipeline-step">
            <span class="idx">02</span>
            <div>
              <div class="title">Spec</div>
              <p class="desc">Requisitos verificáveis, sem ambiguidades.</p>
            </div>
          </div>
          <div class="pipeline-step">
            <span class="idx">03</span>
            <div>
              <div class="title">Craft</div>
              <p class="desc">Implementação com padrões do projeto.</p>
            </div>
          </div>
          <div class="pipeline-step">
            <span class="idx">04</span>
            <div>
              <div class="title">Ship</div>
              <p class="desc">Release controlado e handoff documentado.</p>
            </div>
          </div>
        </div>
      </div>
    </LandingFeature>

    <LandingFeature
      id="projetos"
      index="03"
      label="Craft"
      title="Detalhe que sobrevive ao uso."
      body="Preciso, crafted, purposeful. Tipografia, estados, acessibilidade e performance tratados como parte do produto, não como polish final."
      points={[
        {
          icon: 'ph-thin ph-text-aa',
          text: 'Hierarquia tipográfica legível em um olhar',
        },
        {
          icon: 'ph-thin ph-gauge',
          text: 'Performance medida, não prometida',
        },
        {
          icon: 'ph-thin ph-hand-pointing',
          text: 'Interação mecânica: clique, não swoosh',
        },
      ]}
      linkLabel="Padrões de qualidade"
      linkHref="#engajamentos"
    >
      <div class="vis-panel" aria-hidden="true">
        <div class="vis-head">
          <span class="label">Critérios de entrega</span>
          <span class="meta">checklist</span>
        </div>
        <div class="quality-grid">
          <div class="quality-cell">
            <i class="ph-thin ph-check-circle"></i>
            <div class="title">Contratos claros</div>
            <p class="caption">Aceite verificável</p>
          </div>
          <div class="quality-cell">
            <i class="ph-thin ph-code"></i>
            <div class="title">Código legível</div>
            <p class="caption">Diffs pequenos</p>
          </div>
          <div class="quality-cell">
            <i class="ph-thin ph-test-tube"></i>
            <div class="title">Cobertura útil</div>
            <p class="caption">Comportamento real</p>
          </div>
          <div class="quality-cell">
            <i class="ph-thin ph-rocket-launch"></i>
            <div class="title">Release limpo</div>
            <p class="caption">Rollback pronto</p>
          </div>
        </div>
      </div>
    </LandingFeature>

    <LandingQuote />
    <LandingPricing />
    <LandingCta />
  </main>
  <SiteFooter />
  <ThemeToggle />
</Layout>

<style>
  .vis-panel {
    background: var(--surface1);
    border: 1px solid var(--border);
    border-radius: var(--radius-component);
    padding: var(--space-lg);
    box-shadow: none;
  }

  .vis-panel.featured {
    border-left: 3px solid var(--accent);
  }

  .vis-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  .vis-head .label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text3);
  }

  .vis-head .meta {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    color: var(--text2);
  }

  .stack-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .stack-item {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: var(--space-sm);
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-component);
    background: var(--background);
  }

  .stack-item i {
    color: var(--text2);
    font-size: 16px;
  }

  .stack-item .name {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--text1);
  }

  .stack-item .tag {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-element);
    background: var(--accent-subtle);
    color: #fb923c;
  }

  :global([data-theme='light']) .stack-item .tag {
    color: #c2410c;
  }

  .pipeline {
    display: flex;
    flex-direction: column;
  }

  .pipeline-step {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--border);
  }

  .pipeline-step:last-child {
    border-bottom: none;
  }

  .pipeline-step .idx {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    padding-top: 2px;
  }

  .pipeline-step .title {
    font-family: var(--font-display);
    font-size: var(--text-subheading);
    font-weight: 500;
    color: var(--text1);
    margin-bottom: var(--space-xs);
  }

  .pipeline-step .desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    color: var(--text2);
  }

  .quality-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .quality-cell {
    padding: var(--space-md);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-component);
  }

  .quality-cell i {
    font-size: 20px;
    color: var(--text2);
    margin-bottom: var(--space-sm);
    display: block;
  }

  .quality-cell .title {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--text1);
    margin-bottom: var(--space-2xs);
  }

  .quality-cell .caption {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    color: var(--text3);
  }
</style>
