---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';

const title = 'Política de Privacidade · Afinador de Ukulele';
const description =
  'Política de privacidade do aplicativo Afinador de Ukulele, da Code Studio 92.';
---

<Layout title={title} description={description}>
  <SiteHeader navItems={[]} />

  <main class="privacy-main">
    <div class="policy-enter mb-2xl">
      <div class="policy-enter__row">
        <p
          class="mb-sm text-label font-medium uppercase tracking-[0.06em] text-text-2"
        >
          Afinador de Ukulele
        </p>
        <div class="lang-switch" role="group" aria-label="Idioma">
          <button type="button" data-lang-btn="pt" class="lang-btn is-active" aria-pressed="true">
            PT
          </button>
          <button type="button" data-lang-btn="en" class="lang-btn" aria-pressed="false">
            EN
          </button>
        </div>
      </div>
      <h1 class="policy-title">
        <span data-i18n="pt">Política de Privacidade</span>
        <span data-i18n="en" hidden>Privacy Policy</span>
      </h1>
      <div class="mt-lg h-px w-12 bg-accent" aria-hidden="true"></div>
    </div>

    <!-- PT -->
    <article data-lang-panel="pt" class="policy-prose space-y-2xl">
      <section class="space-y-md">
        <p>
          <strong>Última atualização:</strong> 17 de agosto de 2026
        </p>
        <p>
          A sua privacidade é importante para nós. Esta Política de Privacidade
          descreve como o aplicativo <strong>Afinador de Ukulele</strong> trata
          as informações durante sua utilização.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Coleta de dados</h2>
        <p>
          O <strong>Afinador de Ukulele</strong> não solicita cadastro nem
          coleta dados que você digita (como nome, e-mail ou telefone).
        </p>
        <p>
          A funcionalidade principal de afinação ocorre no dispositivo e o
          processamento de áudio é local; o aplicativo não possui servidor
          próprio para esse processamento.
        </p>
        <p>
          Parte da telemetria é opcional e depende do seu consentimento.
          Diagnóstico e desempenho seguem as regras descritas na seção
          <strong>Serviços Firebase</strong> abaixo.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Uso do microfone</h2>
        <p>
          O aplicativo solicita acesso ao <strong>microfone</strong>
          exclusivamente para identificar a frequência sonora das cordas do
          ukulele e determinar a nota musical correspondente.
        </p>
        <p>O áudio:</p>
        <ul>
          <li>não é gravado;</li>
          <li>não é armazenado;</li>
          <li>não é transmitido para qualquer servidor;</li>
          <li>não é compartilhado com terceiros.</li>
        </ul>
        <p>
          Todo o processamento do áudio ocorre localmente no próprio dispositivo.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Serviços Firebase</h2>
        <p>
          O aplicativo utiliza serviços Firebase (Google). Os dados são
          processados pelo Google conforme a
          <a href="https://policies.google.com/privacy" rel="noopener noreferrer"
            >Política de Privacidade do Google</a
          >.
        </p>
        <p>
          <strong>Estatísticas de uso (opcional).</strong>
          <strong>Google Analytics for Firebase</strong>, incluindo o
          identificador de publicidade quando aplicável, coleta dados de uso do
          app, eventos automáticos e identificadores de app/dispositivo apenas
          após seu <strong>consentimento explícito</strong>, que você pode
          conceder, recusar ou alterar a qualquer momento em
          <strong>Configurações → Preferências de privacidade</strong> (veja
          também <strong>Suas escolhas</strong> abaixo). Se você recusar ou
          desativar essa opção, novas coletas analíticas são interrompidas e
          os dados analíticos locais do dispositivo são redefinidos.
        </p>
        <p>
          <strong>Diagnóstico e desempenho (necessários).</strong>
          Os serviços abaixo são necessários para manter a estabilidade e a
          qualidade do aplicativo e <strong>não dependem</strong> da escolha
          opcional de estatísticas de uso:
        </p>
        <ul>
          <li>
            <strong>Firebase Crashlytics</strong>: stack traces de falhas,
            identificadores de instalação e informações de dispositivo e sistema
            operacional, para diagnosticar e corrigir erros.
          </li>
          <li>
            <strong>Firebase Performance Monitoring</strong>: métricas de
            desempenho (como tempo de início, latência de rede e uso de
            CPU/memória), identificadores de instalação e endereço IP para
            segmentação geográfica agregada.
          </li>
          <li>
            <strong>Release Monitoring</strong> (via Crashlytics): métricas de
            estabilidade e adoção de versões, derivadas dos dados de
            Crashlytics.
          </li>
        </ul>
        <p>
          O uso do identificador de publicidade no contexto de estatísticas de
          uso é detalhado na seção
          <strong>Identificadores de publicidade</strong> abaixo.
        </p>
        <p>
          <strong>Retenção.</strong> Dados analíticos opcionais: enquanto o
          consentimento estiver ativo, sujeitos às políticas do Google. Após a
          revogação, interrompemos novas coletas e redefinimos os dados
          analíticos no dispositivo. Dados de diagnóstico: conforme as
          políticas do <strong>Firebase Crashlytics</strong>.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Identificadores de publicidade</h2>
        <p>
          O <strong>identificador de publicidade</strong> do dispositivo (Android
          Advertising ID) só é utilizado no contexto das
          <strong>estatísticas de uso</strong> quando você as autoriza, conforme
          descrito em <strong>Serviços Firebase</strong> e
          <strong>Suas escolhas</strong>. Esse dado é processado pelo Google
          conforme a
          <a href="https://policies.google.com/privacy" rel="noopener noreferrer"
            >Política de Privacidade do Google</a
          >.
        </p>
        <p>
          O aplicativo <strong>não exibe anúncios</strong> e
          <strong>não utiliza</strong> o identificador para publicidade
          personalizada. O aplicativo não utiliza vinculação a Google Ads ou
          Google Signals.
        </p>
        <p>
          Você pode revogar ou alterar seu consentimento a qualquer momento em
          <strong>Configurações → Preferências de privacidade</strong> (veja
          <strong>Suas escolhas</strong>). Nas configurações de anúncios e
          personalização do dispositivo Android, você também pode limitar o uso
          do identificador de publicidade no nível do sistema operacional.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Suas escolhas</h2>
        <p>
          No <strong>primeiro acesso</strong>, o aplicativo exibe uma tela de
          privacidade antes do uso. Depois, você pode gerenciar suas preferências
          em <strong>Configurações → Preferências de privacidade</strong>.
        </p>
        <p>As opções disponíveis são:</p>
        <ul>
          <li>
            <strong>Consentir</strong>: autoriza as estatísticas de uso (Google
            Analytics for Firebase), incluindo o identificador de publicidade
            quando aplicável;
          </li>
          <li>
            <strong>Não consentir</strong>: mantém as estatísticas de uso
            desativadas;
          </li>
          <li>
            <strong>Personalizar</strong>: permite ajustar suas preferências de
            privacidade.
          </li>
        </ul>
        <p>
          Você pode <strong>revogar ou alterar</strong> seu consentimento a
          qualquer momento pelo mesmo caminho em
          <strong>Configurações → Preferências de privacidade</strong>.
        </p>
        <p>
          Se você recusar ou desativar as estatísticas de uso, novas coletas
          analíticas são interrompidas e os dados analíticos locais do dispositivo
          são redefinidos. O diagnóstico de falhas (Crashlytics) e o
          monitoramento de desempenho (Performance) continuam conforme descrito em
          <strong>Serviços Firebase</strong>.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Serviços de terceiros</h2>
        <p>
          Além dos serviços Firebase descritos acima, o aplicativo interage com
          a infraestrutura da <strong>Google Play</strong>, necessária para
          distribuição, instalação e atualização.
        </p>
        <p>
          Esses serviços são regidos pelas respectivas políticas de privacidade
          da Google.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Permissões</h2>
        <p>O aplicativo solicita as seguintes permissões:</p>
        <ul>
          <li>
            <strong>Microfone</strong>: necessária para detectar a afinação do
            instrumento.
          </li>
          <li>
            <strong>Identificador de publicidade (AD_ID)</strong>: declarado no
            manifesto do aplicativo para que o Google Analytics for Firebase
            acesse o Android Advertising ID no contexto das estatísticas de
            uso, <strong>somente quando você autoriza</strong>, conforme
            descrito nas seções <strong>Identificadores de publicidade</strong>
            e <strong>Suas escolhas</strong>.
          </li>
        </ul>
        <p>
          O microfone é utilizado exclusivamente para afinação. O identificador
          de publicidade é utilizado somente no contexto das estatísticas de uso
          autorizadas, conforme as seções
          <strong>Identificadores de publicidade</strong> e
          <strong>Suas escolhas</strong>.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Controlador e operador de dados</h2>
        <p>
          O controlador dos dados é <strong>Code Studio 92</strong>. Para
          questões sobre esta Política, entre em contato pelo e-mail
          <a href="mailto:codestudio92@gmail.com">codestudio92@gmail.com</a>.
        </p>
        <p>
          O <strong>Google</strong> atua como operador/processador na prestação
          dos serviços Firebase, conforme os termos do Firebase/Google.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Transferência internacional de dados</h2>
        <p>
          Os dados tratados pelo Firebase podem ser processados em servidores fora
          do Brasil e do Espaço Econômico Europeu, inclusive nos Estados Unidos,
          com salvaguardas contratuais aplicáveis pelo Google.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Crianças</h2>
        <p>
          O aplicativo não coleta intencionalmente dados identificáveis
          fornecidos por menores de idade. A telemetria descrita nesta Política
          — incluindo diagnóstico e desempenho necessários — segue as mesmas
          regras aqui descritas.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Alterações nesta política</h2>
        <p>
          Esta Política de Privacidade poderá ser atualizada para refletir
          alterações no funcionamento do aplicativo ou para atender a novos
          requisitos legais.
        </p>
        <p>
          Quando houver mudanças relevantes, a data de atualização será
          modificada nesta página.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Contato</h2>
        <p>
          Caso tenha dúvidas sobre esta Política de Privacidade, entre em
          contato pelo e-mail:
          <a href="mailto:codestudio92@gmail.com">codestudio92@gmail.com</a>.
        </p>
      </section>
    </article>

    <!-- EN -->
    <article data-lang-panel="en" class="policy-prose space-y-2xl" hidden>
      <section class="space-y-md">
        <p>
          <strong>Last updated:</strong> August 17, 2026
        </p>
        <p>
          Your privacy is important to us. This Privacy Policy describes how the
          <strong>Ukulele Tuner</strong> application handles information during
          its use.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Data Collection</h2>
        <p>
          The <strong>Ukulele Tuner</strong> does not require account
          registration and does not collect data you type (such as name, email, or
          phone number).
        </p>
        <p>
          Core tuning functionality runs on your device and audio processing is
          local; the application does not have its own server for that
          processing.
        </p>
        <p>
          Some telemetry is optional and depends on your consent. Diagnostics and
          performance follow the rules described in the
          <strong>Firebase Services</strong> section below.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Microphone Use</h2>
        <p>
          The application requests access to the <strong>microphone</strong>
          exclusively to identify the sound frequency of the ukulele strings and
          determine the corresponding musical note.
        </p>
        <p>The audio:</p>
        <ul>
          <li>is not recorded;</li>
          <li>is not stored;</li>
          <li>is not transmitted to any server;</li>
          <li>is not shared with third parties.</li>
        </ul>
        <p>
          All audio processing occurs locally on the device itself.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Firebase Services</h2>
        <p>
          The application uses Firebase services (Google). Data is processed by
          Google according to the
          <a href="https://policies.google.com/privacy" rel="noopener noreferrer"
            >Google Privacy Policy</a
          >.
        </p>
        <p>
          <strong>Usage statistics (optional).</strong>
          <strong>Google Analytics for Firebase</strong>, including the
          advertising identifier when applicable, collects app usage data,
          automatic events, and app/device identifiers only after your
          <strong>explicit consent</strong>, which you may grant, decline, or
          change at any time in
          <strong>Settings → Privacy preferences</strong> (see also
          <strong>Your choices</strong> below). If you decline or disable this
          option, new analytics collection stops and local analytics data on the
          device is reset.
        </p>
        <p>
          <strong>Diagnostics and performance (required).</strong>
          The services below are necessary to maintain application stability and
          quality and <strong>do not depend</strong> on the optional usage
          statistics choice:
        </p>
        <ul>
          <li>
            <strong>Firebase Crashlytics</strong>: crash stack traces,
            installation identifiers, and device and operating system
            information, to diagnose and fix errors.
          </li>
          <li>
            <strong>Firebase Performance Monitoring</strong>: performance metrics
            (such as app start time, network latency, and CPU/memory usage),
            installation identifiers, and IP address for aggregated geographic
            segmentation.
          </li>
          <li>
            <strong>Release Monitoring</strong> (via Crashlytics): stability and
            version adoption metrics derived from Crashlytics data.
          </li>
        </ul>
        <p>
          Use of the advertising identifier in the context of usage statistics is
          described in the <strong>Advertising Identifiers</strong> section
          below.
        </p>
        <p>
          <strong>Retention.</strong> Optional analytics data: while consent is
          active, subject to Google's policies. After revocation, we stop new
          collection and reset analytics data on the device. Diagnostic data:
          according to <strong>Firebase Crashlytics</strong> policies.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Advertising Identifiers</h2>
        <p>
          The device's <strong>advertising identifier</strong> (Android
          Advertising ID) is used only in the context of
          <strong>usage statistics</strong> when you authorize them, as
          described in <strong>Firebase Services</strong> and
          <strong>Your choices</strong>. This data is processed by Google
          according to the
          <a href="https://policies.google.com/privacy" rel="noopener noreferrer"
            >Google Privacy Policy</a
          >.
        </p>
        <p>
          The application <strong>does not display ads</strong> and
          <strong>does not use</strong> the identifier for personalized
          advertising. The application does not use linking to Google Ads or
          Google Signals.
        </p>
        <p>
          You may revoke or change your consent at any time in
          <strong>Settings → Privacy preferences</strong> (see
          <strong>Your choices</strong>). In your Android device's ads and
          personalization settings, you can also limit use of the advertising
          identifier at the operating system level.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Your choices</h2>
        <p>
          On <strong>first launch</strong>, the application shows a privacy
          screen before use. After that, you can manage your preferences in
          <strong>Settings → Privacy preferences</strong>.
        </p>
        <p>The available options are:</p>
        <ul>
          <li>
            <strong>Consent</strong>: authorizes usage statistics (Google
            Analytics for Firebase), including the advertising identifier when
            applicable;
          </li>
          <li>
            <strong>Do not consent</strong>: keeps usage statistics disabled;
          </li>
          <li>
            <strong>Customize</strong>: lets you adjust your privacy preferences.
          </li>
        </ul>
        <p>
          You may <strong>revoke or change</strong> your consent at any time
          through the same path in
          <strong>Settings → Privacy preferences</strong>.
        </p>
        <p>
          If you decline or disable usage statistics, new analytics collection
          stops and local analytics data on the device is reset. Crash
          diagnostics (Crashlytics) and performance monitoring (Performance)
          continue as described in <strong>Firebase Services</strong>.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Third-Party Services</h2>
        <p>
          In addition to the Firebase services described above, the application
          interacts with the <strong>Google Play</strong> infrastructure,
          required for distribution, installation, and updates.
        </p>
        <p>
          These services are governed by Google's respective privacy policies.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Permissions</h2>
        <p>The application requests the following permissions:</p>
        <ul>
          <li>
            <strong>Microphone</strong>: required to detect the instrument's
            tuning.
          </li>
          <li>
            <strong>Advertising identifier (AD_ID)</strong>: declared in the
            application manifest so Google Analytics for Firebase may access the
            Android Advertising ID in the context of usage statistics,
            <strong>only when you authorize</strong>, as described in the
            <strong>Advertising Identifiers</strong> and
            <strong>Your choices</strong> sections.
          </li>
        </ul>
        <p>
          The microphone is used exclusively for tuning. The advertising
          identifier is used only in the context of authorized usage statistics,
          as described in the <strong>Advertising Identifiers</strong> and
          <strong>Your choices</strong> sections.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Data controller and processor</h2>
        <p>
          The data controller is <strong>Code Studio 92</strong>. For questions
          about this Policy, contact us at
          <a href="mailto:codestudio92@gmail.com">codestudio92@gmail.com</a>.
        </p>
        <p>
          <strong>Google</strong> acts as operator/processor in providing
          Firebase services, under Firebase/Google terms.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>International data transfers</h2>
        <p>
          Data processed by Firebase may be processed on servers outside Brazil
          and the European Economic Area, including the United States, with
          contractual safeguards applied by Google.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Children</h2>
        <p>
          The application does not intentionally collect identifiable information
          provided by minors. Telemetry described in this Policy — including
          required diagnostics and performance — follows the same rules described
          here.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Changes to this policy</h2>
        <p>
          This Privacy Policy may be updated to reflect changes in how the
          application works or to meet new legal requirements.
        </p>
        <p>
          When relevant changes occur, the update date on this page will be
          modified.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Contact</h2>
        <p>
          If you have questions about this Privacy Policy, please contact us by
          email:
          <a href="mailto:codestudio92@gmail.com">codestudio92@gmail.com</a>.
        </p>
      </section>
    </article>
  </main>

  <SiteFooter />
  <ThemeToggle />
</Layout>

<style>
  .privacy-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-xl) var(--space-3xl);
    width: 100%;
  }

  @media (max-width: 560px) {
    .privacy-main {
      padding-inline: var(--space-md);
    }
  }

  .policy-enter__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .policy-enter__row > p {
    margin-bottom: var(--space-sm);
  }

  .lang-switch {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs);
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-control);
  }

  .lang-btn {
    appearance: none;
    border: none;
    background: transparent;
    border-radius: var(--radius-element);
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text2);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-fast),
      background var(--duration-fast) var(--ease-fast);
  }

  .lang-btn.is-active {
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .policy-enter {
    animation: brand-in var(--duration-slow) var(--ease) both;
  }

  .policy-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--text1);
  }

  .policy-prose {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--text1);
  }

  .policy-prose h2 {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 600;
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    color: var(--text1);
  }

  .policy-prose p,
  .policy-prose li {
    color: var(--text2);
  }

  .policy-prose strong {
    color: var(--text1);
    font-weight: 500;
  }

  .policy-prose ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: 0;
  }

  .policy-prose li {
    position: relative;
    padding-left: 16px;
  }

  .policy-prose li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--accent);
  }

  .policy-prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease);
  }

  .policy-prose a:hover {
    color: var(--text1);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
  const panels = document.querySelectorAll<HTMLElement>('[data-lang-panel]');
  const titles = document.querySelectorAll<HTMLElement>('[data-i18n]');

  function setLang(lang: 'pt' | 'en') {
    buttons.forEach((btn) => {
      const active = btn.dataset.langBtn === lang;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.langPanel !== lang;
    });
    titles.forEach((el) => {
      el.hidden = el.dataset.i18n !== lang;
    });
    document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.langBtn;
      if (lang === 'pt' || lang === 'en') setLang(lang);
    });
  });
</script>
