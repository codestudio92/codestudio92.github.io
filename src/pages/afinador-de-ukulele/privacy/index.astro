---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';

const title = 'Política de Privacidade · Afinador de Ukulele';
const description =
  'Política de privacidade do aplicativo Afinador de Ukulele, da Code Studio 92.';
---

<Layout title={title} description={description}>
  <SiteHeader navItems={[]} />

  <main class="privacy-main">
    <div class="policy-enter mb-2xl">
      <div class="policy-enter__row">
        <p
          class="mb-sm text-label font-medium uppercase tracking-[0.06em] text-text-2"
        >
          Afinador de Ukulele
        </p>
        <div class="lang-switch" role="group" aria-label="Idioma">
          <button type="button" data-lang-btn="pt" class="lang-btn is-active" aria-pressed="true">
            PT
          </button>
          <button type="button" data-lang-btn="en" class="lang-btn" aria-pressed="false">
            EN
          </button>
        </div>
      </div>
      <h1 class="policy-title">
        <span data-i18n="pt">Política de Privacidade</span>
        <span data-i18n="en" hidden>Privacy Policy</span>
      </h1>
      <div class="mt-lg h-px w-12 bg-accent" aria-hidden="true"></div>
    </div>

    <!-- PT -->
    <article data-lang-panel="pt" class="policy-prose space-y-2xl">
      <section class="space-y-md">
        <p>
          <strong>Última atualização:</strong> 17 de agosto de 2026
        </p>
        <p>
          A sua privacidade é importante para nós. Esta Política de Privacidade
          descreve como o aplicativo <strong>Afinador de Ukulele</strong> trata
          as informações durante sua utilização.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Coleta de dados</h2>
        <p>
          O <strong>Afinador de Ukulele</strong> não solicita cadastro nem
          coleta dados fornecidos diretamente pelo usuário (como nome, e-mail ou
          telefone).
        </p>
        <p>
          A funcionalidade principal de afinação ocorre no dispositivo do usuário
          e o aplicativo não possui servidor próprio para esse processamento.
        </p>
        <p>
          Dados de uso, diagnóstico e desempenho são coletados automaticamente
          por serviços Firebase (Google), conforme descrito na seção
          <strong>Serviços Firebase</strong> abaixo.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Uso do microfone</h2>
        <p>
          O aplicativo solicita acesso ao <strong>microfone</strong>
          exclusivamente para identificar a frequência sonora das cordas do
          ukulele e determinar a nota musical correspondente.
        </p>
        <p>O áudio:</p>
        <ul>
          <li>não é gravado;</li>
          <li>não é armazenado;</li>
          <li>não é transmitido para qualquer servidor;</li>
          <li>não é compartilhado com terceiros.</li>
        </ul>
        <p>
          Todo o processamento do áudio ocorre localmente no próprio dispositivo.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Serviços Firebase</h2>
        <p>
          O aplicativo utiliza serviços Firebase (Google) para entender o uso,
          diagnosticar falhas e monitorar o desempenho. Os dados são
          processados por Google conforme a
          <a href="https://policies.google.com/privacy" rel="noopener noreferrer"
            >Política de Privacidade do Google</a
          >.
        </p>
        <ul>
          <li>
            <strong>Google Analytics for Firebase</strong>: dados de uso do
            app, eventos automáticos, identificadores de app/dispositivo e
            identificador de publicidade (Android Advertising ID), para
            entender como o aplicativo é utilizado e melhorar o produto.
          </li>
          <li>
            <strong>Firebase Crashlytics</strong>: stack traces de falhas,
            identificadores de instalação e informações de dispositivo e sistema
            operacional, para diagnosticar e corrigir erros.
          </li>
          <li>
            <strong>Firebase Performance Monitoring</strong>: métricas de
            desempenho (como tempo de início, latência de rede e uso de
            CPU/memória), identificadores de instalação e endereço IP para
            segmentação geográfica agregada.
          </li>
          <li>
            <strong>Release Monitoring</strong> (via Crashlytics): métricas de
            estabilidade e adoção de versões, derivadas dos dados de
            Crashlytics.
          </li>
        </ul>
        <p>
          O uso do identificador de publicidade é detalhado na seção
          <strong>Identificadores de publicidade</strong> abaixo.
        </p>
        <p>
          Você pode limitar parte da coleta nas configurações de anúncios e
          personalização do dispositivo Android ou desinstalando o aplicativo.
          A retenção dos dados é regida pelas políticas e configurações do
          Google/Firebase.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Identificadores de publicidade</h2>
        <p>
          O <strong>Google Analytics for Firebase</strong> pode acessar o
          <strong>identificador de publicidade</strong> do dispositivo (Android
          Advertising ID). Esse dado é processado pelo Google conforme a
          <a href="https://policies.google.com/privacy" rel="noopener noreferrer"
            >Política de Privacidade do Google</a
          >.
        </p>
        <p>
          O aplicativo <strong>não exibe anúncios</strong>. O identificador é
          utilizado apenas no contexto da telemetria descrita na seção
          <strong>Serviços Firebase</strong>, para entender o uso e melhorar o
          produto.
        </p>
        <p>
          O aplicativo não utiliza vinculação a Google Ads ou Google Signals.
        </p>
        <p>
          Você pode limitar a coleta do identificador de publicidade nas
          configurações de anúncios e personalização do dispositivo Android.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Serviços de terceiros</h2>
        <p>
          Além dos serviços Firebase descritos acima, o aplicativo interage com
          a infraestrutura da <strong>Google Play</strong>, necessária para
          distribuição, instalação e atualização.
        </p>
        <p>
          Esses serviços são regidos pelas respectivas políticas de privacidade
          da Google.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Permissões</h2>
        <p>O aplicativo solicita apenas a seguinte permissão:</p>
        <ul>
          <li>
            <strong>Microfone</strong>: necessária para detectar a afinação do
            instrumento.
          </li>
        </ul>
        <p>
          Essa permissão é utilizada exclusivamente para essa finalidade.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Crianças</h2>
        <p>
          O aplicativo não coleta intencionalmente dados identificáveis
          fornecidos por menores de idade. A telemetria descrita nos serviços
          Firebase segue as mesmas regras desta Política.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Alterações nesta Política</h2>
        <p>
          Esta Política de Privacidade poderá ser atualizada para refletir
          alterações no funcionamento do aplicativo ou para atender a novos
          requisitos legais.
        </p>
        <p>
          Quando houver mudanças relevantes, a data de atualização será
          modificada nesta página.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Contato</h2>
        <p>
          Caso tenha dúvidas sobre esta Política de Privacidade, entre em
          contato pelo e-mail:
          <a href="mailto:codestudio92@gmail.com">codestudio92@gmail.com</a>.
        </p>
      </section>
    </article>

    <!-- EN -->
    <article data-lang-panel="en" class="policy-prose space-y-2xl" hidden>
      <section class="space-y-md">
        <p>
          <strong>Last updated:</strong> August 17, 2026
        </p>
        <p>
          Your privacy is important to us. This Privacy Policy describes how the
          <strong>Ukulele Tuner</strong> application handles information during
          its use.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Data Collection</h2>
        <p>
          The <strong>Ukulele Tuner</strong> does not require account
          registration and does not collect data provided directly by the user
          (such as name, email, or phone number).
        </p>
        <p>
          Core tuning functionality runs on the user's device and the
          application does not have its own server for that processing.
        </p>
        <p>
          Usage, diagnostic, and performance data are collected automatically by
          Firebase services (Google), as described in the
          <strong>Firebase Services</strong> section below.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Microphone Use</h2>
        <p>
          The application requests access to the <strong>microphone</strong>
          exclusively to identify the sound frequency of the ukulele strings and
          determine the corresponding musical note.
        </p>
        <p>The audio:</p>
        <ul>
          <li>is not recorded;</li>
          <li>is not stored;</li>
          <li>is not transmitted to any server;</li>
          <li>is not shared with third parties.</li>
        </ul>
        <p>
          All audio processing occurs locally on the device itself.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Firebase Services</h2>
        <p>
          The application uses Firebase services (Google) to understand usage,
          diagnose crashes, and monitor performance. Data is processed by Google
          according to the
          <a href="https://policies.google.com/privacy" rel="noopener noreferrer"
            >Google Privacy Policy</a
          >.
        </p>
        <ul>
          <li>
            <strong>Google Analytics for Firebase</strong>: app usage data,
            automatic events, app/device identifiers, and the advertising
            identifier (Android Advertising ID), to understand how the
            application is used and improve the product.
          </li>
          <li>
            <strong>Firebase Crashlytics</strong>: crash stack traces,
            installation identifiers, and device and operating system
            information, to diagnose and fix errors.
          </li>
          <li>
            <strong>Firebase Performance Monitoring</strong>: performance metrics
            (such as app start time, network latency, and CPU/memory usage),
            installation identifiers, and IP address for aggregated geographic
            segmentation.
          </li>
          <li>
            <strong>Release Monitoring</strong> (via Crashlytics): stability and
            version adoption metrics derived from Crashlytics data.
          </li>
        </ul>
        <p>
          Use of the advertising identifier is described in the
          <strong>Advertising Identifiers</strong> section below.
        </p>
        <p>
          You can limit some collection through your Android device's ads and
          personalization settings or by uninstalling the application. Data
          retention is governed by Google/Firebase policies and settings.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Advertising Identifiers</h2>
        <p>
          <strong>Google Analytics for Firebase</strong> may access the device's
          <strong>advertising identifier</strong> (Android Advertising ID). This
          data is processed by Google according to the
          <a href="https://policies.google.com/privacy" rel="noopener noreferrer"
            >Google Privacy Policy</a
          >.
        </p>
        <p>
          The application <strong>does not display ads</strong>. The identifier
          is used only in the context of the telemetry described in the
          <strong>Firebase Services</strong> section, to understand usage and
          improve the product.
        </p>
        <p>
          The application does not use linking to Google Ads or Google Signals.
        </p>
        <p>
          You can limit collection of the advertising identifier through your
          Android device's ads and personalization settings.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Third-Party Services</h2>
        <p>
          In addition to the Firebase services described above, the application
          interacts with the <strong>Google Play</strong> infrastructure,
          required for distribution, installation, and updates.
        </p>
        <p>
          These services are governed by Google's respective privacy policies.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Permissions</h2>
        <p>The application requests only the following permission:</p>
        <ul>
          <li>
            <strong>Microphone</strong>: required to detect the instrument's
            tuning.
          </li>
        </ul>
        <p>
          This permission is used exclusively for that purpose.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Children</h2>
        <p>
          The application does not intentionally collect identifiable
          information provided by minors. Telemetry described under Firebase
          services follows the same rules in this Policy.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Changes to This Policy</h2>
        <p>
          This Privacy Policy may be updated to reflect changes in how the
          application works or to meet new legal requirements.
        </p>
        <p>
          When relevant changes occur, the update date on this page will be
          modified.
        </p>
      </section>

      <section class="space-y-md border-t border-border pt-2xl">
        <h2>Contact</h2>
        <p>
          If you have questions about this Privacy Policy, please contact us by
          email:
          <a href="mailto:codestudio92@gmail.com">codestudio92@gmail.com</a>.
        </p>
      </section>
    </article>
  </main>

  <SiteFooter />
  <ThemeToggle />
</Layout>

<style>
  .privacy-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-xl) var(--space-3xl);
    width: 100%;
  }

  @media (max-width: 560px) {
    .privacy-main {
      padding-inline: var(--space-md);
    }
  }

  .policy-enter__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .policy-enter__row > p {
    margin-bottom: var(--space-sm);
  }

  .lang-switch {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs);
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-control);
  }

  .lang-btn {
    appearance: none;
    border: none;
    background: transparent;
    border-radius: var(--radius-element);
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--text2);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-fast),
      background var(--duration-fast) var(--ease-fast);
  }

  .lang-btn.is-active {
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .policy-enter {
    animation: brand-in var(--duration-slow) var(--ease) both;
  }

  .policy-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--text1);
  }

  .policy-prose {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    letter-spacing: var(--text-body--letter-spacing);
    color: var(--text1);
  }

  .policy-prose h2 {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 600;
    line-height: var(--text-heading--line-height);
    letter-spacing: var(--text-heading--letter-spacing);
    color: var(--text1);
  }

  .policy-prose p,
  .policy-prose li {
    color: var(--text2);
  }

  .policy-prose strong {
    color: var(--text1);
    font-weight: 500;
  }

  .policy-prose ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: 0;
  }

  .policy-prose li {
    position: relative;
    padding-left: 16px;
  }

  .policy-prose li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--accent);
  }

  .policy-prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease);
  }

  .policy-prose a:hover {
    color: var(--text1);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]');
  const panels = document.querySelectorAll<HTMLElement>('[data-lang-panel]');
  const titles = document.querySelectorAll<HTMLElement>('[data-i18n]');

  function setLang(lang: 'pt' | 'en') {
    buttons.forEach((btn) => {
      const active = btn.dataset.langBtn === lang;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.langPanel !== lang;
    });
    titles.forEach((el) => {
      el.hidden = el.dataset.i18n !== lang;
    });
    document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.langBtn;
      if (lang === 'pt' || lang === 'en') setLang(lang);
    });
  });
</script>
