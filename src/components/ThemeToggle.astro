---
import ReIcon from './ReIcon.astro';
---

<div class="theme-bar" role="group" aria-label="Tema">
  <button type="button" data-theme-btn="light" aria-label="Tema claro">
    <span class="theme-icon"><ReIcon name="sun" size={16} /></span>
    <span>Claro</span>
  </button>
  <button type="button" data-theme-btn="dark" aria-label="Tema escuro">
    <span class="theme-icon"><ReIcon name="moon" size={16} /></span>
    <span>Escuro</span>
  </button>
</div>

<style>
  .theme-bar {
    position: fixed;
    bottom: var(--space-lg);
    right: var(--space-lg);
    left: auto;
    z-index: 200;
    display: flex;
    gap: var(--space-2xs);
    padding: var(--space-xs);
    background: var(--surface1);
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-pill);
    box-shadow: none;
  }

  .theme-bar button {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text3);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    transition:
      background var(--duration-fast) var(--ease-fast),
      color var(--duration-fast) var(--ease-fast);
  }

  .theme-icon {
    display: inline-flex;
    line-height: 0;
  }

  .theme-bar button.active {
    background: var(--surface2);
    color: var(--text1);
  }

  .theme-bar button:hover {
    color: var(--text1);
  }

  @media (max-width: 560px) {
    .theme-bar {
      right: var(--space-md);
      bottom: var(--space-md);
    }
  }
</style>

<script>
  function readTheme(): 'dark' | 'light' {
    const current = document.documentElement.dataset.theme;
    if (current === 'light' || current === 'dark') return current;
    return 'dark';
  }

  function syncActive(theme: 'dark' | 'light') {
    document.querySelectorAll('[data-theme-btn]').forEach((btn) => {
      const el = btn as HTMLButtonElement;
      el.classList.toggle('active', el.dataset.themeBtn === theme);
    });
  }

  function applyTheme(theme: 'dark' | 'light') {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('cs92-theme', theme);
    } catch {
      /* session-only when storage is blocked */
    }
    syncActive(theme);
  }

  syncActive(readTheme());

  document.querySelectorAll('[data-theme-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = (btn as HTMLButtonElement).dataset.themeBtn;
      if (next === 'light' || next === 'dark') {
        applyTheme(next);
      }
    });
  });
</script>
