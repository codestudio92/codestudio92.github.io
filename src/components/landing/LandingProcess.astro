---
import ReIcon from '../ReIcon.astro';
import type { ReiconName } from '../../lib/reicons';

const steps: { title: string; body: string; icon: ReiconName }[] = [
  {
    title: 'Descobrimos',
    body: 'Entendemos o problema antes de escrever qualquer linha de código.',
    icon: 'crosshairs',
  },
  {
    title: 'Projetamos',
    body: 'Planejamos arquitetura, experiência e tecnologia.',
    icon: 'ruler-pen',
  },
  {
    title: 'Construímos',
    body: 'Desenvolvemos soluções com foco em qualidade e manutenção.',
    icon: 'code',
  },
  {
    title: 'Evoluímos',
    body: 'Produtos digitais nunca ficam prontos. Eles evoluem continuamente.',
    icon: 'arrows-rotate',
  },
];
---

<section id="metodo" class="lp-process">
  <div class="shell">
    <div class="head">
      <div class="eyebrow">
        <span class="num">03</span>
        <span class="mark" aria-hidden="true"></span>
        <span class="label">Método</span>
      </div>
      <h2>Como trabalhamos</h2>
    </div>

    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="step">
            <div class="step-meta">
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="step-icon">
                <ReIcon name={step.icon} size={18} />
              </span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .lp-process {
    border-bottom: 1px solid var(--border);
    padding: var(--space-4xl) 0;
  }

  .shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    width: 100%;
  }

  .head {
    margin-bottom: var(--space-3xl);
    max-width: 40ch;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .num {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text3);
  }

  .mark {
    width: 24px;
    height: 1px;
    background: var(--accent);
  }

  .label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text2);
  }

  .lp-process h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text1);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .step {
    padding: var(--space-xl) var(--space-lg) 0 0;
    border-right: 1px solid var(--border);
    min-height: 100%;
  }

  .step:last-child {
    border-right: none;
    padding-right: 0;
  }

  .step:not(:first-child) {
    padding-left: var(--space-lg);
  }

  .step-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .step-num {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .step-icon {
    color: var(--text3);
  }

  .step h3 {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-subheading);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text1);
  }

  .step p {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    line-height: 1.55;
    color: var(--text2);
    max-width: 28ch;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }

    .step {
      border-right: none;
      padding: var(--space-xl) 0 0;
      border-bottom: 1px solid var(--border);
    }

    .step:nth-child(odd) {
      padding-right: var(--space-lg);
      border-right: 1px solid var(--border);
    }

    .step:nth-child(even) {
      padding-left: var(--space-lg);
    }

    .step:nth-last-child(-n + 2) {
      border-bottom: none;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .step,
    .step:nth-child(odd),
    .step:nth-child(even) {
      border-right: none;
      padding: var(--space-xl) 0 0;
      border-bottom: 1px solid var(--border);
    }

    .step:last-child {
      border-bottom: none;
    }
  }
</style>
