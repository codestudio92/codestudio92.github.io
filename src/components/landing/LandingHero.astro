---
import BrandLockup from '../BrandLockup.astro';
---

<section class="lp-hero">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-layout">
      <div class="hero-copy brand-enter">
        <h1 class="hero-brand">
          <BrandLockup size="hero" class="hero-lockup" />
        </h1>
        <p class="hero-sub">Transformando ideias em produtos digitais</p>
      </div>

      <div class="hero-subject" data-parallax-root aria-hidden="true">
        <div class="forge-ring r1" data-depth="0.12"></div>
        <div class="forge-ring r2" data-depth="0.28"></div>
        <div class="forge-ring r3" data-depth="0.48"></div>
        <div class="forge-rect a" data-depth="0.36"></div>
        <div class="forge-rect b" data-depth="0.58"></div>
        <div class="forge-line v1" data-depth="0.7"></div>
        <div class="forge-line h1" data-depth="0.32"></div>
        <div class="forge-dot d1" data-depth="0.82"></div>
        <div class="forge-dot d2" data-depth="0.9"></div>
        <span class="forge-code" data-depth="0.55">forge.build()</span>
      </div>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector('[data-parallax-root]');

  if (root instanceof HTMLElement && !reduceMotion) {
    const layers = Array.from(root.querySelectorAll('[data-depth]')).filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    const maxOffset = 48;
    let frame = 0;

    const tick = () => {
      current.x += (target.x - current.x) * 0.12;
      current.y += (target.y - current.y) * 0.12;

      for (const layer of layers) {
        const depth = Number(layer.dataset.depth) || 0;
        const x = current.x * depth;
        const y = current.y * depth;
        layer.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
      }

      frame = requestAnimationFrame(tick);
    };

    const hero = root.closest('.lp-hero');
    const track = hero instanceof HTMLElement ? hero : root;

    const onPointerMove = (event: PointerEvent) => {
      const rect = track.getBoundingClientRect();
      const midX = rect.left + rect.width / 2;
      const midY = rect.top + rect.height / 2;
      const halfW = Math.max(rect.width / 2, 1);
      const halfH = Math.max(rect.height / 2, 1);
      const nx = Math.max(-1, Math.min(1, (event.clientX - midX) / halfW));
      const ny = Math.max(-1, Math.min(1, (event.clientY - midY) / halfH));
      target.x = nx * maxOffset;
      target.y = ny * maxOffset;
    };

    const onPointerLeave = () => {
      target.x = 0;
      target.y = 0;
    };

    track.addEventListener('pointermove', onPointerMove, { passive: true });
    track.addEventListener('pointerleave', onPointerLeave);
    frame = requestAnimationFrame(tick);

    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(frame);
        track.removeEventListener('pointermove', onPointerMove);
        track.removeEventListener('pointerleave', onPointerLeave);
      },
      { once: true },
    );
  }
</script>

<style>
  .lp-hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--space-4xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .container {
    position: relative;
    z-index: 10;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    width: 100%;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 75% 70% at 60% 45%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 60% 45%, black 20%, transparent 75%);
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      ellipse 80% 70% at 50% 40%,
      transparent 40%,
      var(--background) 100%
    );
    opacity: 0.85;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--space-3xl);
    align-items: center;
    width: 100%;
  }

  .hero-copy {
    max-width: 720px;
    width: 100%;
  }

  .hero-brand {
    margin: 0 0 var(--space-xl);
  }

  .hero-lockup {
    pointer-events: auto;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.6vw, 16px);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.011em;
    color: var(--text2);
    max-width: 32ch;
    margin: 0;
  }

  .hero-subject {
    position: relative;
    justify-self: end;
    width: min(100%, 420px);
    aspect-ratio: 1;
    overflow: visible;
    z-index: 5;
    pointer-events: auto;
  }

  .hero-subject [data-depth] {
    will-change: transform;
  }

  .forge-ring {
    position: absolute;
    border: 1px solid var(--border-visible);
    border-radius: 50%;
  }

  .forge-ring.r1 {
    inset: 8%;
  }

  .forge-ring.r2 {
    inset: 22%;
    border-color: var(--text3);
    opacity: 0.55;
  }

  .forge-ring.r3 {
    inset: 36%;
    border-color: var(--accent);
    opacity: 0.7;
  }

  .forge-rect {
    position: absolute;
    border: 1px solid var(--text2);
    background: transparent;
  }

  .forge-rect.a {
    width: 34%;
    height: 22%;
    top: 18%;
    left: 14%;
    border-radius: var(--radius-element);
  }

  .forge-rect.b {
    width: 28%;
    height: 28%;
    bottom: 20%;
    right: 16%;
    border-radius: var(--radius-component);
    background: var(--surface1);
    border-color: var(--border);
  }

  .forge-line {
    position: absolute;
    background: var(--accent);
    width: 1px;
  }

  .forge-line.v1 {
    height: 42%;
    top: 12%;
    left: 52%;
  }

  .forge-line.h1 {
    width: 36%;
    height: 1px;
    top: 48%;
    left: 28%;
    background: var(--text3);
  }

  .forge-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    background: transparent;
  }

  .forge-dot.d1 {
    top: 30%;
    right: 28%;
  }

  .forge-dot.d2 {
    bottom: 32%;
    left: 30%;
    background: var(--accent);
    border-color: var(--accent);
  }

  .forge-code {
    position: absolute;
    bottom: 14%;
    left: 12%;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text3);
    letter-spacing: 0.04em;
  }

  @media (max-width: 900px) {
    .hero-layout {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .hero-subject {
      justify-self: center;
      width: min(280px, 70vw);
      opacity: 0.55;
      pointer-events: none;
    }

    .lp-hero {
      min-height: auto;
      padding: var(--space-3xl) 0 var(--space-4xl);
    }
  }

  @media (max-width: 560px) {
    .container {
      padding: 0 var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy {
      animation: none;
    }

    .hero-subject [data-depth] {
      transform: none !important;
    }
  }
</style>
