---
import ButtonLink from '../ButtonLink.astro';

const MAILTO = 'mailto:codestudio92br@gmail.com';

const tiers = [
  {
    tier: 'Sprint',
    name: 'Forja rápida',
    desc: 'Duas semanas focadas em um problema: discovery, protótipo ou entrega vertical.',
    points: [
      '1 frente (web, mobile ou AI)',
      'Spec + demos semanais',
      'Handoff com critérios',
    ],
    ctaLabel: 'Conversar',
    featured: false,
  },
  {
    tier: 'Produto',
    name: 'Construção contínua',
    desc: 'Squad enxuto moldando o produto com backlog priorizado e releases regulares.',
    points: [
      'Design + engenharia',
      'Pipeline de entrega',
      'Revisão de qualidade',
    ],
    ctaLabel: 'Iniciar conversa',
    featured: true,
  },
  {
    tier: 'Parceria',
    name: 'Studio embutido',
    desc: 'Presença contínua no time do cliente: arquitetura, craft e governança técnica.',
    points: [
      'Ownership de domínio',
      'Mentoria de engenharia',
      'Roadmap alinhado',
    ],
    ctaLabel: 'Conversar',
    featured: false,
  },
] as const;
---

<section id="engajamentos" class="lp-pricing">
  <div class="container">
    <div class="pricing-head">
      <span class="label">Engajamentos</span>
      <h2>Pacotes leves. Escopo concreto.</h2>
      <p>Modelos de parceria para times que precisam de craft com ritmo, sem contrato genérico.</p>
    </div>
    <div class="pricing-grid">
      {
        tiers.map((card) => (
          <div class:list={['price-card', { featured: card.featured }]}>
            <span class="tier">{card.tier}</span>
            <div class="name">{card.name}</div>
            <p class="desc">{card.desc}</p>
            <ul>
              {card.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <ButtonLink
              href={MAILTO}
              variant={card.featured ? 'primary' : 'secondary'}
            >
              {card.ctaLabel}
            </ButtonLink>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lp-pricing {
    padding: var(--space-4xl) 0;
    border-bottom: 1px solid var(--border);
    background: var(--surface1);
  }

  .container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    width: 100%;
  }

  .pricing-head {
    text-align: center;
    max-width: 560px;
    margin: 0 auto var(--space-2xl);
  }

  .pricing-head .label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text3);
    display: inline-block;
    margin-bottom: var(--space-md);
  }

  .pricing-head h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-heading);
    letter-spacing: -0.015em;
    color: var(--text1);
    margin: 0 0 var(--space-sm);
  }

  .pricing-head p {
    margin: 0;
    font-size: var(--text-body);
    color: var(--text2);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .price-card {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-component);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    box-shadow: none;
  }

  .price-card.featured {
    border-color: var(--border-visible);
    background: var(--surface2);
  }

  .price-card .tier {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text3);
  }

  .price-card .name {
    font-family: var(--font-display);
    font-size: var(--text-subheading);
    font-weight: 500;
    color: var(--text1);
  }

  .price-card .desc {
    margin: 0;
    font-size: var(--text-body-sm);
    color: var(--text2);
    flex: 1;
  }

  .price-card ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .price-card li {
    font-size: var(--text-body-sm);
    color: var(--text1);
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .price-card li::before {
    content: '';
    width: 6px;
    height: 1px;
    background: var(--text3);
    margin-top: 10px;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
