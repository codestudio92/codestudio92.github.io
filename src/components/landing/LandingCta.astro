---
import ButtonLink from '../ButtonLink.astro';
---

<section class="lp-cta-block">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="container">
    <span class="label">Próximo passo</span>
    <h2>Traga a complexidade. Levamos a forma.</h2>
    <p>
      Uma conversa curta para entender o problema, as restrições e se o encaixe
      faz sentido.
    </p>
    <div class="cta-row">
      <ButtonLink href="mailto:codestudio92br@gmail.com" variant="primary">
        Iniciar conversa
      </ButtonLink>
      <ButtonLink href="#projetos" variant="secondary">
        Ver projetos
      </ButtonLink>
    </div>
    <p class="cta-note">Resposta em até 2 dias úteis · sem pitch genérico</p>
  </div>
</section>

<style>
  .lp-cta-block {
    position: relative;
    overflow: hidden;
    padding: var(--space-4xl) 0;
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.55;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(
      ellipse 60% 50% at 50% 50%,
      black 10%,
      transparent 70%
    );
  }

  .container {
    position: relative;
    z-index: 10;
    max-width: 640px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    width: 100%;
  }

  .label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text3);
    display: inline-block;
    margin-bottom: var(--space-md);
  }

  .lp-cta-block h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.02em;
    color: var(--text1);
    margin: 0 0 var(--space-md);
  }

  .lp-cta-block p {
    margin: 0 0 var(--space-xl);
    font-size: var(--text-body);
    color: var(--text2);
  }

  .cta-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .cta-note {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    color: var(--text3);
  }
</style>
