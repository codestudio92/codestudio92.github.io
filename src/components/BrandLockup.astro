---
interface Props {
  href?: string;
  class?: string;
  size?: 'default' | 'hero';
  variant?: 'lockup' | 'icon';
}

const {
  href = '/',
  class: className,
  size = 'default',
  variant = 'lockup',
} = Astro.props;

const isIcon = variant === 'icon';
---

<a
  href={href}
  class:list={[
    'brand-lockup',
    size === 'hero' && 'brand-lockup--hero',
    isIcon && 'brand-lockup--icon',
    className,
  ]}
  aria-label="Code Studio 92"
>
  {
    isIcon ? (
      <>
        <img
          class="brand-logo brand-logo--on-dark"
          src="/brand/icon-92-on-dark.png"
          alt=""
          width="793"
          height="675"
          decoding="async"
        />
        <img
          class="brand-logo brand-logo--on-light"
          src="/brand/icon-92.png"
          alt=""
          width="793"
          height="675"
          decoding="async"
        />
      </>
    ) : (
      <>
        <img
          class="brand-logo brand-logo--on-dark"
          src="/brand/logo-on-dark.svg"
          alt=""
          width="1024"
          height="341"
          decoding="async"
        />
        <img
          class="brand-logo brand-logo--on-light"
          src="/brand/logo-on-light.svg"
          alt=""
          width="1024"
          height="341"
          decoding="async"
        />
      </>
    )
  }
</a>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
    color: inherit;
  }

  .brand-logo {
    display: block;
    width: auto;
    height: 28px;
    max-width: 100%;
  }

  .brand-lockup--icon .brand-logo {
    height: 32px;
  }

  .brand-logo--on-light {
    display: none;
  }

  :global(html[data-theme='light']) .brand-logo--on-dark {
    display: none;
  }

  :global(html[data-theme='light']) .brand-logo--on-light {
    display: block;
  }

  .brand-lockup--hero .brand-logo {
    height: clamp(72px, 14vw, 140px);
  }
</style>
