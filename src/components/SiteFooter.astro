---
import BrandLockup from './BrandLockup.astro';
---

<footer class="lp-footer">
  <div class="lp-footer__inner">
    <div class="lp-footer__top">
      <div class="brand-col">
        <BrandLockup />
        <p>Transformando ideias em produtos digitais</p>
      </div>
      <div class="col">
        <h4>Studio</h4>
        <ul>
          <li><a href="/#oficio">Ofício</a></li>
          <li><a href="/#principios">Princípios</a></li>
          <li><a href="/#metodo">Método</a></li>
        </ul>
      </div>
      <div class="col">
        <h4>Apps</h4>
        <ul>
          <li>
            <a href="/marcador-de-truco/privacy/">Marcador de Truco — Privacidade</a>
          </li>
        </ul>
      </div>
      <div class="col">
        <h4>Contato</h4>
        <ul>
          <li>
            <a href="mailto:codestudio92@gmail.com">codestudio92@gmail.com</a>
          </li>
        </ul>
      </div>
    </div>
    <p class="copyright">© 2026 Code Studio 92</p>
  </div>
</footer>

<style>
  .lp-footer {
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  .lp-footer__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    width: 100%;
  }

  .lp-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-xl);
  }

  .brand-col p {
    margin: var(--space-md) 0 0;
    font-size: var(--text-body-sm);
    color: var(--text2);
    max-width: 28ch;
    line-height: 1.5;
  }

  .copyright {
    margin: var(--space-4xl) 0 0;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    color: var(--text3);
    text-align: center;
  }

  .col h4 {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text3);
    margin: 0 0 var(--space-md);
  }

  .col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .col a {
    font-size: var(--text-body-sm);
    color: var(--text2);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-fast);
  }

  .col a:hover {
    color: var(--text1);
  }

  @media (max-width: 900px) {
    .lp-footer__top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .lp-footer__inner {
      padding: 0 var(--space-md);
    }

    .brand-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .brand-col p {
      max-width: 22ch;
    }
  }
</style>
