---
import BrandLockup from './BrandLockup.astro';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems?: NavItem[] | null;
}

const defaultNav: NavItem[] = [
  { label: 'Ofício', href: '/#oficio' },
  { label: 'Princípios', href: '/#principios' },
  { label: 'Método', href: '/#metodo' },
];

const { navItems = defaultNav } = Astro.props;
const items = navItems ?? [];
const hasNav = items.length > 0;
---

<header class="lp-header">
  <div class="lp-header__inner">
    <BrandLockup variant="icon" />
    {
      hasNav && (
        <nav class="lp-nav" aria-label="Principal">
          {items.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      )
    }
  </div>
</header>

<style>
  .lp-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    height: 56px;
    box-shadow: none;
  }

  .lp-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    height: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    width: 100%;
  }

  .lp-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .lp-nav a {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text2);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-fast);
  }

  .lp-nav a:hover {
    color: var(--text1);
  }

  @media (max-width: 560px) {
    .lp-header__inner {
      padding: 0 var(--space-md);
    }

    .lp-nav {
      display: none;
    }
  }
</style>
