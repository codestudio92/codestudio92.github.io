---
import BrandLockup from './BrandLockup.astro';
import ButtonLink from './ButtonLink.astro';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems?: NavItem[];
}

const defaultNav: NavItem[] = [
  { label: 'Serviços', href: '#servicos' },
  { label: 'Método', href: '#metodo' },
  { label: 'Projetos', href: '#projetos' },
  { label: 'Studio', href: '#studio' },
];

const { navItems = defaultNav } = Astro.props;
---

<header class="lp-header">
  <div class="lp-header__inner">
    <BrandLockup />
    <nav class="lp-nav" aria-label="Principal">
      {
        navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
    <div class="lp-header-actions">
      <ButtonLink href="mailto:codestudio92br@gmail.com" variant="primary">
        Iniciar conversa
      </ButtonLink>
    </div>
  </div>
</header>

<style>
  .lp-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    height: 56px;
    box-shadow: none;
  }

  .lp-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    width: 100%;
  }

  .lp-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .lp-nav a {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--text2);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-fast);
  }

  .lp-nav a:hover {
    color: var(--text1);
  }

  .lp-header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  @media (max-width: 900px) {
    .lp-nav {
      display: none;
    }
  }
</style>
